        <name>Notes List</name>
        <option_schema/>
        <public>false</public>
        <roles/>
        <script><![CDATA[(function() {
  data.notes = [];
  var noteGR = new GlideRecord('x_snc_createnotes_createnote');
  noteGR.addQuery('user', gs.getUserID());
  noteGR.orderByDesc('sys_created_on');
  noteGR.query();
  while (noteGR.next()) {
    var noteObj = {};
    noteObj.sys_id = noteGR.getValue('sys_id');
    noteObj.note = noteGR.getValue('note').slice(0, 20);
    data.notes.push(noteObj);
  }
})();
]]></script>
